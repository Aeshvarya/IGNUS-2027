---
import { NAV, MENU } from '../config/site';
import { registerHref } from '../lib/api';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const reg = registerHref();
---
<header class="hud-top">
  <a class="brand" href="/" aria-label="IGNUS home">
    <img src="/logos/wordmark-mono.svg" alt="IGNUS" width="1566" height="553">
  </a>
  <nav class="hud-nav" aria-label="Main">
    {NAV.map((n) => (
      <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
    <a class="nav-cta" href={reg ?? '/passes/'} data-register>Register</a>
    <button class="menu-btn" type="button" data-menu-open aria-haspopup="dialog" aria-controls="pause"><i aria-hidden="true"></i><span>Menu</span></button>
  </nav>
</header>

<dialog class="pause" id="pause" aria-labelledby="pause-title">
  <div class="pause-inner">
    <div class="pause-head">
      <h2 class="pause-title" id="pause-title">Paused</h2>
      <button class="pause-close" type="button" data-menu-close aria-label="Close menu">Esc</button>
    </div>
    <nav aria-label="All pages">
      <ul class="pause-list">
        {MENU.map((n, i) => (
          <li>
            <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined} data-menu-link>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <b>{n.label}</b>
              <small>{n.short}</small>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="pause-opts">
      <button class="opt" type="button" data-lite-toggle aria-pressed="false"><span class="pip" aria-hidden="true"></span>Lite mode</button>
      <button class="opt" type="button" data-sound-toggle aria-pressed="false" hidden><span class="pip" aria-hidden="true"></span>Sound</button>
    </div>
  </div>
</dialog>
