# Cache and security headers. Read by Cloudflare Pages and Netlify; other hosts need the
# equivalent config (see README → Deploying).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Fingerprinted build output: cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Large, rarely changing assets without hashes: cache a week, refresh in the background.
/models/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/posters/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/gpu/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
